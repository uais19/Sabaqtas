[{"text":"ТЕСТОВЫЙ ТЕКСТ — заменить на настоящий фрагмент учебника. Дробью называют одну или несколько равных частей целого. Число под чертой — знаменатель, оно показывает, на сколько равных частей разделили целое. Число над чертой — числитель, оно показывает, сколько таких частей взяли. В записи 3/4 знаменатель равен четырём, а числитель равен трём.","subject":"Математика","grade":5,"part":"часть 1","paragraph":"§12","page":45,"embedding":[0.004077,0.004847,0.021793,-0.011591,-0.020939,-0.004323,0.052702,-0.052602,0.027814,-0.071796,-0.031493,0.019002,0.03832,-0.028072,0.055553,0.004273,-0.007891,-0.04037,-0.007748,-0.000902,-0.052412,0.010264,-0.031307,0.012986,-0.048838,-0.013166,0.040222,-0.01784,-0.015815,0.2281,0.005056,-0.054143,-0.010821,-0.008709,0.015178,-0.001385,-0.00863,-0.00178,-0.006421,0.025551,0.000662,0.025786,-0.029175,-0.021961,-0.005852,-0.034324,-0.030348,0.049815,-0.02021,-0.004678,0.015433,0.02333,-0.006063,-0.042963,0.031542,0.010652,0.01047,0.031148,0.015031,-0.004723,-0.022593,-0.030266,0.033641,-0.047918,-0.018946,0.010895,0.035144,-0.035014,-0.007126,0.002554,-0.0007,-0.022622,0.022507,-0.012118,0.029213,0.021755,0.007783,0.005085,0.036931,0.025277,0.039199,0.030312,0.006874,0.003572,-0.000863,-0.010201,-0.000382,0.0426,0.013408,0.058322,0.025316,0.0052,0.010585,-0.015723,0.040615,-0.013344,-0.024825,0.029407,0.034449,0.028754,-0.003914,0.01758,-0.025253,-0.025837,0.002657,-0.044284,0.018664,-0.012383,0.044589,-0.048273,-0.001527,-0.252942,-0.010031,-0.026958,0.004351,-0.046007,0.014187,0.00406,0.016834,0.014536,0.016926,0.027765,0.002336,-0.027806,-0.004798,0.045143,0.03783,-0.005604,-0.022726,0.022671,0.02763,-0.009599,0.011713,-0.013367,-0.000186,0.003145,-0.012575,-0.015028,0.013463,0.011264,0.000975,0.029847,-0.002295,-0.020193,-0.001529,0.074114,-0.001325,0.002957,0.038727,0.020313,6.1e-05,0.021037,-0.033284,0.000925,0.021249,0.002647,0.011018,-0.007095,0.020517,0.030835,-0.008383,-0.032782,-0.022645,-0.012502,-0.028369,0.051914,0.