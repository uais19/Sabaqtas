[{"text":"Дробью называют одну или несколько равных частей целого. Число под чертой — знаменатель, оно показывает, на сколько равных частей разделили целое. Число над чертой — числитель, оно показывает, сколько таких частей взяли. В записи 3/4 знаменатель равен четырём, а числитель равен трём.","subject":"Математика","grade":5,"part":"часть 1","paragraph":"§12","page":45,"is_placeholder":true,"embedding":[0.016888,0.010704,0.015817,-0.019299,-0.040438,0.005301,0.047746,-0.038123,0.04831,-0.072265,-0.024044,0.026872,0.012613,-0.042913,0.051361,0.017401,-0.003663,-0.012104,-0.017556,-0.021522,-0.07243,0.010315,-0.019876,-0.009681,-0.025268,0.00383,0.044521,0.006402,-0.025987,0.222023,0.013076,-0.047753,-0.006084,0.009409,0.007338,0.001605,-0.028493,-0.01185,-0.011594,0.018087,-0.01045,0.003593,-0.041161,-0.023904,-0.018104,-0.035337,-0.028851,0.03891,-0.03272,0.006263,0.021075,0.018627,0.009224,-0.044543,0.03395,0.049152,0.001714,0.023055,0.028123,0.001902,-0.027873,0.003915,0.029613,-0.020149,-0.018579,0.011103,0.023601,-0.022075,-0.016439,0.004174,-0.010173,-0.019231,0.019188,0.011317,0.033276,0.037932,0.023937,-0.029017,0.035668,0.031663,0.046557,0.034607,-0.006062,-0.013893,-0.039982,-0.015053,-0.008498,0.061165,0.021811,0.048667,0.033993,0.002061,0.026856,-0.009532,0.038082,0.001615,-0.02576,0.023932,0.044283,0.002427,0.02235,-0.000188,-0.02005,0.000951,-0.002723,-0.040437,-0.003045,0.009427,0.072203,-0.05426,-0.009122,-0.263846,-0.029845,-0.014843,-0.022427,-0.043072,0.012553,0.00192,-0.002159,0.022819,0.014833,0.025382,0.009478,-0.041203,-0.006877,0.038615,0.041156,-0.019238,-0.016949,0.022064,0.014848,0.006822,0.003959,0.000337,0.000742,-0.013154,-0.003509,-0.004327,0.008518,0.017529,0.003805,0.015316,0.007164,-0.031842,-0.018938,0.085871,-0.023064,0.012148,0.042238,0.017196,0.002262,0.002443,-0.016703,-0.004617,0.022401,-0.002972,0.009515,-0.010584,0.018142,0.049407,-0.020907,-0.048422,-0.011876,-0.026026,-0.035861,0.053231,0.002953,-0.016475,-0.035127,0.0431